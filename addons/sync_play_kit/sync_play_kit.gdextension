[configuration]

entry_symbol = "sync_play_kit_library_init"
compatibility_minimum = "4.3"

[libraries]

windows.debug.x86_64   = "res://addons/sync_play_kit/bin/sync_play_kit.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/sync_play_kit/bin/sync_play_kit.windows.template_release.x86_64.dll"
linux.debug.x86_64     = "res://addons/sync_play_kit/bin/sync_play_kit.linux.template_debug.x86_64.so"
linux.release.x86_64   = "res://addons/sync_play_kit/bin/sync_play_kit.linux.template_release.x86_64.so"
macos.debug            = "res://addons/sync_play_kit/bin/sync_play_kit.macos.template_debug.framework"
macos.release          = "res://addons/sync_play_kit/bin/sync_play_kit.macos.template_release.framework"
android.debug.arm64    = "res://addons/sync_play_kit/bin/libsync_play_kit.android.template_debug.arm64.so"
android.release.arm64  = "res://addons/sync_play_kit/bin/libsync_play_kit.android.template_release.arm64.so"
